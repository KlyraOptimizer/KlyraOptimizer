<Window x:Class="KlyraOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:KlyraOptimizer.Core"
        Title="Klyra Optimizer"
        Icon="pack://application:,,,/Assets/KlyraOptimizer.ico"
        Width="1240" Height="800"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.Ui}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Borda externa reta de 1px do Windows 10 UWP -->
    <Border x:Name="OuterFrame"
            BorderBrush="{DynamicResource App.WindowBorder}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ======================= NAVIGATIONVIEW ACRYLIC (ESTILO XAML CONTROLS GALLERY 1809) ======================= -->
            <Border x:Name="NavPane"
                    Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                    Width="49"
                    Background="{DynamicResource App.PaneAcrylic}"
                    BorderBrush="{DynamicResource App.Divider}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="0">
                <DockPanel>

                    <!-- Barra de titulo superior esquerda (32px) -->
                    <Grid DockPanel.Dock="Top" Height="32">
                        <StackPanel x:Name="PaneAppTitle"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="15,0,12,0"
                                    Visibility="Collapsed">
                            <Image Source="pack://application:,,,/Assets/KlyraOptimizer.png"
                                   Width="16" Height="16"
                                   VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Margin="0,0,8,0" />
                            <TextBlock Text="Klyra Optimizer"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.Text}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Botao Voltar (48x40) sempre posicionado acima do Hamburguer igual na XAML Controls Gallery -->
                    <Button x:Name="BackButton"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Nav.IconButton}"
                            Content="&#xE72B;"
                            ToolTip="Voltar"
                            IsEnabled="False"
                            Click="Back_Click" />

                    <!-- Botao Hamburguer (48x40) -->
                    <Button x:Name="HamburgerButton"
                            DockPanel.Dock="Top"
                            Style="{StaticResource Nav.Hamburger}"
                            ToolTip="Abrir ou recolher navegação"
                            Click="Hamburger_Click" />

                    <!-- AutoSuggestBox integrado no topo do NavigationView (igual a XAML Controls Gallery) -->
                    <Grid DockPanel.Dock="Top" Margin="0,4,0,6">
                        <!-- Modo expandido: Caixa de pesquisa com botao X + lupa em colunas separadas (estilo XAML Controls Gallery) -->
                        <Grid x:Name="NavSearchHost" Margin="12,0,12,0" Visibility="Collapsed">
                            <Border Background="{DynamicResource App.InputBackground}"
                                    BorderBrush="{DynamicResource App.InputStroke}"
                                    BorderThickness="1"
                                    CornerRadius="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NavSearchBox"
                                             Grid.Column="0"
                                             Height="30"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="10,4,4,4"
                                             Style="{StaticResource Input.Win10}"
                                             Tag="Pesquisar"
                                             TextChanged="NavSearchBox_TextChanged"
                                             KeyDown="NavSearchBox_KeyDown"
                                             LostKeyboardFocus="NavSearchBox_LostFocus" />
                                    <Button Grid.Column="1"
                                            Width="32" Height="30"
                                            Style="{StaticResource Btn.Subtle}"
                                            core:FluentEffects.EnableTilt="False"
                                            BorderThickness="0"
                                            Padding="0"
                                            Focusable="False"
                                            ToolTip="Pesquisar"
                                            Click="NavSearchSubmit_Click">
                                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                                   Foreground="{DynamicResource App.TextSecondary}" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Popup quadrado de sugestoes instantaneas -->
                            <Popup x:Name="NavSuggestionsPopup"
                                   PlacementTarget="{Binding ElementName=NavSearchBox}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade">
                                <Border Width="256"
                                        MaxHeight="280"
                                        Background="{DynamicResource App.CardSolid}"
                                        BorderBrush="{DynamicResource App.CardStrokeHover}"
                                        BorderThickness="1"
                                        CornerRadius="0"
                                        Margin="0,1,0,0"
                                        Padding="0,4">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="NavSuggestionsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource Btn.Subtle}"
                                                            Height="34"
                                                            Padding="12,0"
                                                            HorizontalContentAlignment="Left"
                                                            Tag="{Binding}"
                                                            Click="NavSuggestion_Click">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="24" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Glyph}"
                                                                       FontFamily="{StaticResource Font.Icons}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource App.AccentText}"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Label}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource App.Text}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Modo compacto (48px): Botao Lupa que expande o menu e foca a busca -->
                        <Button x:Name="NavSearchCompactButton"
                                Style="{StaticResource Nav.IconButton}"
                                Content="&#xE721;"
                                ToolTip="Pesquisar"
                                Visibility="Visible"
                                Click="NavSearchCompact_Click" />
                    </Grid>

                    <!-- Rodape fixo do NavigationView (Banner Admin + Modo Ativo + Configuracoes) -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,4,0,4">

                        <Border x:Name="AdminBanner"
                                Background="{DynamicResource App.WarningSoft}"
                                BorderBrush="{DynamicResource App.Warning}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Padding="12,10"
                                Margin="12,0,12,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Modo limitado"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Warning}" />
                                <TextBlock Text="Alguns ajustes exigem privilégios de Administrador."
                                           Style="{StaticResource Text.Caption}"
                                           Margin="0,2,0,8" />
                                <Button Content="Elevar agora"
                                        Style="{StaticResource Btn.Accent}"
                                        Height="28"
                                        FontSize="12"
                                        Padding="12,0"
                                        HorizontalAlignment="Left"
                                        Click="Elevate_Click" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ModeStatusBox"
                                Background="{DynamicResource App.Hover}"
                                BorderBrush="{DynamicResource App.CardStroke}"
                                BorderThickness="1"
                                CornerRadius="0"
                                Margin="12,0,12,6"
                                Padding="12,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="PERFIL ATIVO" Style="{StaticResource Text.Section}" Margin="0,0,0,2" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ModeGlyph"
                                               Text="&#xE946;"
                                               Style="{StaticResource Icon}"
                                               FontSize="13"
                                               Foreground="{DynamicResource App.TextTertiary}"
                                               Margin="0,0,8,0" />
                                    <TextBlock x:Name="ModeText"
                                               Text="Nenhum modo aplicado"
                                               FontSize="12"
                                               Foreground="{DynamicResource App.TextSecondary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Divider}" Margin="12,4,12,4" />

                        <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                     Content="Configurações" Tag="&#xE713;" CommandParameter="settings"
                                     ToolTip="Configurações"
                                     Checked="Nav_Checked" />
                    </StackPanel>

                    <!-- Itens de navegacao -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Content="Início" Tag="&#xE80F;" CommandParameter="home"
                                         ToolTip="Início"
                                         IsChecked="True" Checked="Nav_Checked" />
                            <RadioButton x:Name="NavOptimizer" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Content="Otimizador" Tag="&#xE945;" CommandParameter="optimizer"
                                         ToolTip="Otimizador"
                                         Checked="Nav_Checked" />

                            <!-- NavigationViewItemSeparator igual a XAML Controls Gallery -->
                            <Border Style="{StaticResource Divider}" Margin="12,6,12,6" />

                            <RadioButton x:Name="NavTool" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Content="Klyra Tool" Tag="&#xE90F;" CommandParameter="tool"
                                         ToolTip="Klyra Tool (Funções ao vivo)"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavStore" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Content="Microsoft Store" Tag="&#xE719;" CommandParameter="store"
                                         ToolTip="Loja de aplicativos"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavTools" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Content="Ferramentas" Tag="&#xEC7A;" CommandParameter="tools"
                                         ToolTip="Ferramentas e hardware"
                                         Checked="Nav_Checked" />
                            <RadioButton x:Name="NavRestore" GroupName="Nav" Style="{StaticResource Nav.Item}"
                                         Content="Restauração" Tag="&#xE81C;" CommandParameter="restore"
                                         ToolTip="Restauração do sistema"
                                         Checked="Nav_Checked" />
                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- ======================= BARRA DE TITULO DIREITA (32px, estilo Win10) ======================= -->
            <Border Grid.Row="0" Grid.Column="1"
                    Background="{DynamicResource App.PageBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="CollapsedTitleText"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Visibility="Visible">
                        <Image Source="pack://application:,,,/Assets/KlyraOptimizer.png"
                               Width="16" Height="16"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,8,0" />
                        <TextBlock Text="Klyra Optimizer"
                                   FontSize="12"
                                   Foreground="{DynamicResource App.Text}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource TitleBar.Button}"
                                Content="&#xE921;"
                                ToolTip="Minimizar"
                                Click="Minimize_Click" />
                        <Button x:Name="MaxRestoreButton"
                                Style="{StaticResource TitleBar.Button}"
                                Content="&#xE922;"
                                ToolTip="Maximizar"
                                Click="MaxRestore_Click" />
                        <Button Style="{StaticResource TitleBar.CloseButton}"
                                Content="&#xE8BB;"
                                ToolTip="Fechar"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======================= AREA DE CONTEUDO OPACA DO WINDOWS 10 ======================= -->
            <Border Grid.Row="1" Grid.Column="1"
                    Background="{DynamicResource App.PageBackground}"
                    ClipToBounds="True">
                <ContentControl x:Name="PageHost" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform Y="0" />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>

            <!-- ======================= CONTENTDIALOG GLOBAL NATIVO DO WINDOWS 10 ======================= -->
            <Grid x:Name="GlobalDialogOverlay"
                  Grid.Row="0" Grid.RowSpan="2"
                  Grid.Column="0" Grid.ColumnSpan="2"
                  Background="#99000000"
                  Visibility="Collapsed">
                <Border Width="480"
                        MaxWidth="548"
                        Background="{DynamicResource App.CardSolid}"
                        BorderBrush="{DynamicResource App.CardStrokeHover}"
                        BorderThickness="1"
                        CornerRadius="0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="24,20,24,22">
                            <TextBlock x:Name="GlobalDialogTitle"
                                       Text="Confirmar"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource App.Text}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="GlobalDialogBody"
                                       Style="{StaticResource Text.Body}"
                                       Margin="0,12,0,0" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Background="{DynamicResource App.DialogFooter}"
                                BorderBrush="{DynamicResource App.Divider}"
                                BorderThickness="0,1,0,0"
                                Padding="24,16">
                            <UniformGrid x:Name="GlobalDialogButtonsGrid" Columns="2">
                                <Button x:Name="GlobalDialogPrimaryBtn"
                                        Content="OK"
                                        Style="{StaticResource Btn.Accent}"
                                        Margin="0,0,4,0"
                                        Click="GlobalDialogPrimary_Click" />
                                <Button x:Name="GlobalDialogCloseBtn"
                                        Content="Cancelar"
                                        Style="{StaticResource Btn.Standard}"
                                        Margin="4,0,0,0"
                                        Click="GlobalDialogClose_Click" />
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

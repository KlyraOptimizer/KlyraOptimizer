    <!-- ===================================================================
         CHIPS / BADGES RETOS (CornerRadius="0", BorderThickness="1")
         =================================================================== -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Chip.Accent" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
    </Style>

    <Style x:Key="Chip.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================
         NAVIGATIONVIEW DO WINDOWS 10 1809 (XAML CONTROLS GALLERY)
         Botao Hamburguer 48x40 + Indicador vertical azul 3px + Reveal + Press
         =================================================================== -->
    <Style x:Key="Nav.IconButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="core:FluentEffects.EnableReveal" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Bd" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="PART_RevealFill" CornerRadius="0" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PART_RevealBorder" BorderThickness="1" CornerRadius="0" Opacity="0" IsHitTestVisible="False" />
                        <TextBlock Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="16"
                                   Foreground="{DynamicResource App.Text}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.32" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.Hamburger" TargetType="Button" BasedOn="{StaticResource Nav.IconButton}">
        <Setter Property="Content" Value="&#xE700;" />
    </Style>

    <Style x:Key="Nav.Item" TargetType="RadioButton">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="core:FluentEffects.EnableReveal" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid ClipToBounds="True" SnapsToDevicePixels="True">
                        <Border x:Name="Hover" CornerRadius="0" Background="Transparent" />
                        <Border x:Name="PART_RevealFill" CornerRadius="0" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PART_RevealBorder" CornerRadius="0" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
                        <!-- Indicador vertical azul classico de 3px do NavigationView 1809 -->
                        <Border x:Name="Indicator"
                                Width="3" Height="24" CornerRadius="0"
                                Background="{DynamicResource App.Accent}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0,0.5"
                                Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph"
                                       Grid.Column="0"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="16"
                                       Foreground="{DynamicResource App.Text}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="Label"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource Font.Ui}"
                                       FontSize="14"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource App.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource App.NavSelected}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="4.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         PIVOT HEADER DO WINDOWS 10 (Abas superiores da Loja com underline 2px)
         =================================================================== -->
    <Style x:Key="Pivot.Tab" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="Padding" Value="0,6,0,8" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        <Border x:Name="Underline"
                                Height="2"
                                CornerRadius="0"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource App.Accent}"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         RADIOBUTTON CLASSICO DO WINDOWS 10 (Igual ao SettingsPage da Galeria)
         =================================================================== -->
    <Style x:Key="Radio.Win10" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent" VerticalAlignment="Center">
                        <Grid Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse x:Name="OuterCircle"
                                     Width="20" Height="20"
                                     Stroke="{DynamicResource App.InputStroke}"
                                     StrokeThickness="2"
                                     Fill="Transparent" />
                            <Ellipse x:Name="InnerDot"
                                     Width="10" Height="10"
                                     Fill="{DynamicResource App.Text}"
                                     Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterCircle" Property="Stroke" Value="{DynamicResource App.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OuterCircle" Property="Stroke" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="InnerDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource Radio.Win10}" />

    <!-- ===================================================================
         SELETORES SEGMENTADOS RETOS (CornerRadius="0", 1px + Reveal + Press)
         =================================================================== -->
    <Style x:Key="Pill.Radio" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="core:FluentEffects.EnableReveal" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                CornerRadius="0"
                                Background="{DynamicResource App.ControlFill}"
                                BorderBrush="{DynamicResource App.ControlStroke}"
                                BorderThickness="1" />
                        <Border x:Name="PART_RevealFill" CornerRadius="0" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PART_RevealBorder" CornerRadius="0" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="12,6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.CardHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeCard" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="core:FluentEffects.EnableReveal" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd"
                                Background="{DynamicResource App.Card}"
                                BorderBrush="{DynamicResource App.CardStroke}"
                                BorderThickness="1"
                                CornerRadius="0" />
                        <Border x:Name="Glow"
                                Background="{DynamicResource App.AccentSoft}"
                                CornerRadius="0"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PART_RevealFill" CornerRadius="0" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="PART_RevealBorder" CornerRadius="0" BorderThickness="1" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter Margin="16" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.CardHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         CHECKBOX CLASSICO DO WINDOWS 10 1809 (20x20, CornerRadius="0", 1px)
         =================================================================== -->
    <Style x:Key="Check.Fluent" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent" SnapsToDevicePixels="True">
                        <Border x:Name="Box"
                                Width="20" Height="20"
                                CornerRadius="0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource App.InputStroke}"
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Mark"
                                       Text="&#xE73E;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="13"
                                       Foreground="{DynamicResource App.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource Check.Fluent}" />

</ResourceDictionary>

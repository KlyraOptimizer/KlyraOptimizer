<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================================================================
         TIPOGRAFIA DO WINDOWS 10 (Segoe UI + Segoe MDL2 Assets)
         =================================================================== -->
    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas, Cascadia Mono</FontFamily>

    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="Text.Subheader" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Semilight, Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>

    <Style x:Key="Text.CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Section" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextTertiary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <!-- ===================================================================
         SCROLLBAR FINA DO WINDOWS 10 UWP
         =================================================================== -->
    <Style x:Key="Win10ScrollBarThumb" TargetType="Thumb">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar"
                            Background="{DynamicResource App.TextTertiary}"
                            Opacity="0.55"
                            Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.85" />
                            <Setter TargetName="Bar" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter TargetName="Bar" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="8" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Win10ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="8" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Win10ScrollBarThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================
         SUPERFICIES DO WINDOWS 10 (cantos retos CornerRadius="0")
         =================================================================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="20,16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Card.Tight" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <Style x:Key="Card.Solid" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Background" Value="{DynamicResource App.CardSolid}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource App.Divider}" />
        <Setter Property="Margin" Value="0,12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================================================================
         CAIXA DE TEXTO UWP DO WINDOWS 10 (Tag = placeholder)
         =================================================================== -->
    <Style x:Key="Input.Win10" TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource App.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource App.Accent}" />
        <Setter Property="Background" Value="{DynamicResource App.InputBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.InputStroke}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="0">
                        <Grid>
                            <TextBlock x:Name="Placeholder"
                                       Text="{TemplateBinding Tag}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Foreground="{DynamicResource App.TextTertiary}"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="0"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.ControlStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         BOTOES DE JANELA DO WINDOWS 10 (46 x 32, cantos retos)
         =================================================================== -->
    <Style x:Key="TitleBar.Button" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleBar.CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBar.Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <TextBlock x:Name="Glyph"
                                   Text="{TemplateBinding Content}"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="10"
                                   Foreground="{DynamicResource App.Text}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFE81123" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFF1707A" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="#FF000000" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         BOTOES UWP DO WINDOWS 10 (CornerRadius 0, Reveal stroke 2px no hover,
         PointerDownThemeAnimation 0.98)
         =================================================================== -->
    <ControlTemplate x:Key="Template.Button" TargetType="ButtonBase">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0" />
            <Border x:Name="RevealStroke"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    CornerRadius="0"
                    IsHitTestVisible="False" />
            <Border x:Name="Overlay"
                    Background="{DynamicResource App.HoverOverlay}"
                    CornerRadius="0"
                    Opacity="0"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RevealStroke" Property="BorderBrush" Value="{DynamicResource App.ControlStrokeHover}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.08" Duration="0:0:0.10" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.14" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="RevealStroke" Property="BorderBrush" Value="Transparent" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.18" Duration="0:0:0.06" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="0.98" Duration="0:0:0.06" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="0.98" Duration="0:0:0.06" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Overlay" Property="Opacity" Value="0" />
                <Setter TargetName="RevealStroke" Property="BorderBrush" Value="Transparent" />
                <Setter TargetName="Root" Property="Opacity" Value="0.40" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="Template" Value="{StaticResource Template.Button}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

    <Style x:Key="Btn.Accent" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource App.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
    </Style>

    <Style x:Key="Btn.Standard" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource App.ControlFill}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.ControlStroke}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="Btn.Subtle" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
    </Style>

    <Style x:Key="Btn.AccentText" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.AccentText}" />
    </Style>

    <Style x:Key="Btn.Danger" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource App.DangerFill}" />
        <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>

    <Style x:Key="Btn.Small" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Standard}">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="12,0" />
    </Style>

    <Style x:Key="Btn.SmallSubtle" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Subtle}">
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Bloco clicavel estilo Tile do Windows 10 Settings (cantos retos + Reveal border) -->
    <ControlTemplate x:Key="Template.Tile" TargetType="ButtonBase">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0" />
            <Border x:Name="Reveal"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    CornerRadius="0"
                    IsHitTestVisible="False" />
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.CardHover}" />
                <Setter TargetName="Reveal" Property="BorderBrush" Value="{DynamicResource App.CardStrokeHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Pressed}" />
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="0.985" Duration="0:0:0.06" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="0.985" Duration="0:0:0.06" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                             To="1" Duration="0:0:0.12" />
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                             To="1" Duration="0:0:0.12" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Btn.Tile" TargetType="ButtonBase" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Template" Value="{StaticResource Template.Tile}" />
        <Setter Property="Background" Value="{DynamicResource App.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================
         CHIPS / BADGES RETOS DO WINDOWS 10
         =================================================================== -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource App.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Chip.Accent" TargetType="Border" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource App.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Accent}" />
    </Style>

    <Style x:Key="Chip.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================
         SPLITVIEW NAVIGATIONVIEW DO WINDOWS 10
         Icone fixo na coluna de 48px + barra retangular de 4x24px na borda
         esquerda (NavigationViewSelectionIndicator do SDK 10.0.19041.0).
         =================================================================== -->
    <Style x:Key="Nav.Hamburger" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Bd" Background="Transparent">
                        <Border x:Name="Reveal" BorderBrush="Transparent" BorderThickness="1" />
                        <TextBlock Text="&#xE700;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="16"
                                   Foreground="{DynamicResource App.Text}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Hover}" />
                            <Setter TargetName="Reveal" Property="BorderBrush" Value="{DynamicResource App.CardStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Pressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Nav.Item" TargetType="RadioButton">
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid ClipToBounds="True">
                        <Border x:Name="Hover" CornerRadius="0" Background="Transparent" />
                        <Border x:Name="Reveal" CornerRadius="0" BorderThickness="1" BorderBrush="Transparent" />
                        <Border x:Name="Indicator"
                                Width="4" Height="24" CornerRadius="0"
                                Background="{DynamicResource App.Accent}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0,0.5"
                                Opacity="0">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="0" />
                            </Border.RenderTransform>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Glyph"
                                       Grid.Column="0"
                                       Text="{TemplateBinding Tag}"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="16"
                                       Foreground="{DynamicResource App.Text}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="Label"
                                       Grid.Column="1"
                                       Text="{TemplateBinding Content}"
                                       FontFamily="{StaticResource Font.Ui}"
                                       FontSize="15"
                                       Margin="2,0,12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource App.Hover}" />
                            <Setter TargetName="Reveal" Property="BorderBrush" Value="{DynamicResource App.CardStroke}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource App.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Hover" Property="Background" Value="{DynamicResource App.NavSelected}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <ExponentialEase EasingMode="EaseOut" Exponent="4.5" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.10" />
                                        <DoubleAnimation Storyboard.TargetName="Indicator"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="0:0:0.10" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         PIVOT HEADER DO WINDOWS 10 (Abas superiores da Loja com underline 2px)
         =================================================================== -->
    <Style x:Key="Pivot.Tab" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="Padding" Value="0,6,0,8" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource App.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        <Border x:Name="Underline"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource App.Accent}"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Underline" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================
         SELETORES SEGMENTADOS RETOS DO WINDOWS 10 (substitui pilulas redondas)
         =================================================================== -->
    <Style x:Key="Pill.Radio" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd"
                            CornerRadius="0"
                            Padding="12,5"
                            Background="{DynamicResource App.ControlFill}"
                            BorderBrush="{DynamicResource App.ControlStroke}"
                            BorderThickness="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.ControlStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource App.OnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModeCard" TargetType="RadioButton">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{DynamicResource App.Card}"
                                BorderBrush="{DynamicResource App.CardStroke}"
                                BorderThickness="2"
                                CornerRadius="0" />
                        <Border x:Name="Glow"
                                Background="{DynamicResource App.AccentSoft}"
                                CornerRadius="0"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <ContentPresenter Margin="16" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource App.CardHover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.CardStrokeHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Check.Fluent" TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="20" Height="20"
                                CornerRadius="0"
                                BorderThickness="2"
                                BorderBrush="{DynamicResource App.InputStroke}"
                                Background="Transparent"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="Mark"
                                       Text="&#xE73E;"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="12"
                                       Foreground="{DynamicResource App.OnAccent}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Accent}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource App.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

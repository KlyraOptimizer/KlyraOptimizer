<UserControl x:Class="KlyraOptimizer.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:KlyraOptimizer.Core"
             xmlns:views="clr-namespace:KlyraOptimizer.Views"
             Background="Transparent"
             FontFamily="{StaticResource Font.Ui}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,36" MaxWidth="1120" HorizontalAlignment="Left">

            <!-- ===================== CABECALHO LIMPO (SEM BANNER AZUL) ===================== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Início" Style="{StaticResource Text.PageTitle}" />
                    <TextBlock x:Name="SubtitleText"
                               Style="{StaticResource Text.PageSubtitle}"
                               Text="Visão geral do sistema e acesso rápido às camadas de otimização." />

                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                            <TextBlock x:Name="HeroOsChip" Text="Windows 10" Style="{StaticResource Chip.Text}" />
                        </Border>
                        <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                            <TextBlock x:Name="HeroModeChip" Text="Modo: nenhum" Style="{StaticResource Chip.Text}" />
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock x:Name="HeroAdminText" Text="Administrador" Style="{StaticResource Chip.Text}" />
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <Button Grid.Column="1"
                        Style="{StaticResource Btn.Accent}"
                        Height="34"
                        Padding="22,0"
                        VerticalAlignment="Center"
                        Margin="24,0,0,0"
                        Content="Otimizar agora"
                        Click="GoOptimizer_Click" />
            </Grid>

            <StackPanel Margin="0,24,0,0">

                <!-- ===================== ESTADO DO COMPUTADOR ===================== -->
                <TextBlock Text="Estado do computador" Style="{StaticResource Text.Subheader}" Margin="0,0,0,12" />

                <UniformGrid Columns="2">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE770;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource App.AccentText}" VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SISTEMA OPERACIONAL" Style="{StaticResource Text.Section}" Margin="0,0,0,3" />
                                <TextBlock x:Name="SystemValue" Text="—"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SystemDetail" Text="—" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource App.AccentText}" VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PERFIL DE OTIMIZAÇÃO ATIVO" Style="{StaticResource Text.Section}" Margin="0,0,0,3" />
                                <TextBlock x:Name="ModeValue" Text="—"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}" />
                                <TextBlock x:Name="ModeDetail" Text="—" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource App.AccentText}" VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="INSTALADOR DE PACOTES (WINGET)" Style="{StaticResource Text.Section}" Margin="0,0,0,3" />
                                <TextBlock x:Name="WingetValue" Text="—"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}" />
                                <TextBlock x:Name="WingetDetail" Text="—" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="26"
                                       Foreground="{DynamicResource App.AccentText}" VerticalAlignment="Top" Margin="0,2,16,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PROTEÇÃO E RESTAURAÇÃO" Style="{StaticResource Text.Section}" Margin="0,0,0,3" />
                                <TextBlock x:Name="RestoreValue" Text="—"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}" />
                                <TextBlock x:Name="RestoreDetail" Text="—" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- ===================== GRADE DE AMOSTRAS ESTILO XAML CONTROLS GALLERY ===================== -->
                <Grid Margin="0,28,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Módulos do Klyra Optimizer" Style="{StaticResource Text.Subheader}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <views:Win10ProgressRing x:Name="ScanRing" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,8,0" />
                        <TextBlock x:Name="ScanFeedback" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Cards no formato ControlItemTemplate da XAML Controls Gallery (3 colunas, Reveal + Press + Badge reto) -->
                <UniformGrid Columns="3">
                    <Button Style="{StaticResource Btn.Tile}" Height="118" Padding="14" Margin="0,0,12,12"
                            VerticalContentAlignment="Stretch" Click="GoOptimizer_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="28"
                                       VerticalAlignment="Top" Margin="2,4,16,0" Foreground="{DynamicResource App.Text}" />
                            <StackPanel Grid.Column="1" Margin="0,2,0,0">
                                <TextBlock Text="Otimizador" FontSize="16" Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Aplique os perfis Standard, Medium ou Avançado com proteção anti-conflito."
                                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource App.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-14,-14,0" Padding="7,2">
                                <TextBlock Text="Principal" FontSize="11" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Height="118" Padding="14" Margin="0,0,12,12"
                            VerticalContentAlignment="Stretch" Click="GoTool_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" FontSize="28"
                                       VerticalAlignment="Top" Margin="2,4,16,0" Foreground="{DynamicResource App.Text}" />
                            <StackPanel Grid.Column="1" Margin="0,2,0,0">
                                <TextBlock Text="Klyra Tool" FontSize="16" Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Chaves ToggleSwitch ao vivo para recursos do Windows, limpeza de RAM e rede."
                                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{DynamicResource App.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,-14,-14,0" Padding="7,2">
                                <TextBlock Text="Ao vivo" FontSize="11" Foreground="White" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Height="118" Padding="14" Margin="0,0,0,12"
                            VerticalContentAlignment="Stretch" Click="GoStore_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE719;" Style="{StaticResource Icon}" FontSize="28"
                                       VerticalAlignment="Top" Margin="2,4,16,0" Foreground="{DynamicResource App.Text}" />
                            <StackPanel Grid.Column="1" Margin="0,2,0,0">
                                <TextBlock Text="Microsoft Store" FontSize="16" Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Pesquise no catálogo oficial e instale via winget sem conta Microsoft."
                                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Height="118" Padding="14" Margin="0,0,12,0"
                            VerticalContentAlignment="Stretch" Click="Scan_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="28"
                                       VerticalAlignment="Top" Margin="2,4,16,0" Foreground="{DynamicResource App.Text}" />
                            <StackPanel Grid.Column="1" Margin="0,2,0,0">
                                <TextBlock Text="Scanner de conflitos" FontSize="16" Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Detecta alterações prévias de telemetria, agendamento de CPU e HAGS."
                                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Height="118" Padding="14" Margin="0,0,12,0"
                            VerticalContentAlignment="Stretch" Click="GoRestore_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="28"
                                       VerticalAlignment="Top" Margin="2,4,16,0" Foreground="{DynamicResource App.Text}" />
                            <StackPanel Grid.Column="1" Margin="0,2,0,0">
                                <TextBlock Text="Restauração" FontSize="16" Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Gerencie Pontos de Restauração do Windows ou reverta todos os ajustes."
                                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Height="118" Padding="14" Margin="0"
                            VerticalContentAlignment="Stretch" Click="GoSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" FontSize="28"
                                       VerticalAlignment="Top" Margin="2,4,16,0" Foreground="{DynamicResource App.Text}" />
                            <StackPanel Grid.Column="1" Margin="0,2,0,0">
                                <TextBlock Text="Configurações" FontSize="16" Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Alterne entre tema escuro/claro, consulte especificações e abra os logs."
                                           Style="{StaticResource Text.Caption}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </UniformGrid>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="KlyraOptimizer.Views.KlyraToolPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KlyraOptimizer.Views"
             Background="Transparent"
             FontFamily="{StaticResource Font.Ui}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,36" MaxWidth="1100" HorizontalAlignment="Left">

                <TextBlock Text="Klyra Tool" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Text="Painel pós-otimização: troque de perfil, use chaves ToggleSwitch ao vivo em recursos individuais do Windows e execute manutenção rápida." />

                <!-- ===================== MODO ATUAL ===================== -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <views:Win10ProgressBar x:Name="BusyBar" Height="6" Visibility="Collapsed" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="PERFIL ATIVO NO SISTEMA" Style="{StaticResource Text.Section}" Margin="0,0,0,3" />
                                <TextBlock x:Name="CurrentModeText" Text="Nenhum modo aplicado"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{DynamicResource App.Text}" />
                                <TextBlock x:Name="CurrentModeDetail" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                                           Text="Aplique um modo no Otimizador ou migre diretamente abaixo." />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="SwitchStandard" Content="Standard" Tag="1"
                                        Style="{StaticResource Btn.Small}" Margin="0,0,6,0" Click="SwitchMode_Click" />
                                <Button x:Name="SwitchMedium" Content="Medium" Tag="2"
                                        Style="{StaticResource Btn.Small}" Margin="0,0,6,0" Click="SwitchMode_Click" />
                                <Button x:Name="SwitchAdvanced" Content="Avançado" Tag="3"
                                        Style="{StaticResource Btn.Small}" Click="SwitchMode_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== FUNCOES AO VIVO COM TOGGLESWITCH WIN10 ===================== -->
                <Grid Margin="0,28,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Otimizações individuais ao vivo (Ativado = Otimizado)" Style="{StaticResource Text.Subheader}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <views:Win10ProgressRing x:Name="BusyRing" Width="20" Height="20" Visibility="Collapsed" Margin="0,0,8,0" />
                        <TextBlock x:Name="ActionStatus" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="0">
                    <ItemsControl x:Name="ToggleList" AlternationCount="64">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border x:Name="Sep" Height="1" Background="{DynamicResource App.Divider}" Margin="16,0" />
                                    <Grid Margin="16,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34" Height="34"
                                                Background="{DynamicResource App.ControlFill}"
                                                BorderBrush="{DynamicResource App.CardStroke}"
                                                BorderThickness="1"
                                                CornerRadius="0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="15" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="2"
                                                  Style="{StaticResource ToggleSwitch.Win10}"
                                                  IsChecked="{Binding IsOptimized, Mode=OneWay}"
                                                  Tag="{Binding}"
                                                  VerticalAlignment="Center"
                                                  Click="RowSwitch_Click" />
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ===================== UTILITARIOS ===================== -->
                <TextBlock Text="Manutenção rápida" Style="{StaticResource Text.Subheader}" Margin="0,28,0,12" />

                <!-- Opcao dedicada: Remover apps do computador (sem aplicar nenhum perfil) -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="38" Height="38"
                                Background="{DynamicResource App.AccentSoft}"
                                BorderBrush="{DynamicResource App.Accent}"
                                BorderThickness="1"
                                CornerRadius="0"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xECC9;" Style="{StaticResource Icon}" FontSize="17"
                                       Foreground="{DynamicResource App.AccentText}" />
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="Remover apps do computador" Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                       Text="Escolhe e desinstala aplicativos pré-instalados do Windows sem aplicar nenhum perfil de otimização." />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Remover apps do computador"
                                Style="{StaticResource Btn.Accent}"
                                VerticalAlignment="Center"
                                Click="OpenRemoveApps_Click" />
                    </Grid>
                </Border>

                <UniformGrid Columns="4">
                    <Button Style="{StaticResource Btn.Tile}" Click="CleanRam_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource App.AccentText}" />
                            <TextBlock Text="Limpar RAM" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,2" />
                            <TextBlock Text="Working set e temporários" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Click="ResetNetwork_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE895;" Style="{StaticResource Icon}" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource App.AccentText}" />
                            <TextBlock Text="Reset de rede" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,2" />
                            <TextBlock Text="Winsock, IP e DNS" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Click="Reregister_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource App.AccentText}" />
                            <TextBlock Text="Re-registrar Apps" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,2" />
                            <TextBlock Text="Restaura apps nativos" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Margin="0" Click="GpuMsi_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource App.AccentText}" />
                            <TextBlock Text="MSI Mode GPU" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,2" />
                            <TextBlock Text="Interrupções por GPU" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== CONTENTDIALOG WIN10 ===================== -->
        <Grid x:Name="ConfirmOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Width="500"
                    Background="{DynamicResource App.CardSolid}"
                    BorderBrush="{DynamicResource App.CardStrokeHover}"
                    BorderThickness="1"
                    CornerRadius="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,20,24,20">
                        <TextBlock x:Name="ConfirmTitle" Text="Confirmar"
                                   FontSize="20" FontWeight="Light" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="ConfirmText" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="{DynamicResource App.DialogFooter}"
                            BorderBrush="{DynamicResource App.Divider}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <UniformGrid Columns="2">
                            <Button Content="Continuar" Style="{StaticResource Btn.Accent}" Margin="0,0,4,0" Click="ConfirmAction_Click" />
                            <Button Content="Cancelar" Style="{StaticResource Btn.Standard}" Margin="4,0,0,0" Click="CancelConfirm_Click" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== CONTENTDIALOG WIN10: ESCOLHAM APPS PARA SEREM REMOVIDOS (AVULSO) ===================== -->
        <Grid x:Name="AppRemovalOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Width="560"
                    MaxHeight="540"
                    Background="{DynamicResource App.CardSolid}"
                    BorderBrush="{DynamicResource App.CardStrokeHover}"
                    BorderThickness="1"
                    CornerRadius="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Escolham apps para serem removidos"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource App.Text}" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="0,6,0,12"
                                       Text="Os aplicativos desnecessários padrão já vêm marcados automaticamente. Desmarque caso queira manter algum deles — nenhum perfil será alterado." />
                        </StackPanel>

                        <!-- Estado central de carregamento: ProgressRing + "Carregando apps do computador" -->
                        <StackPanel x:Name="AppRemovalLoadingPanel"
                                    Grid.Row="1"
                                    MinHeight="230"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <views:Win10ProgressRing Width="36" Height="36" HorizontalAlignment="Center" />
                            <TextBlock Text="Carregando apps do computador"
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- Lista de aplicativos carregados com CheckBox ao lado -->
                        <Grid x:Name="AppRemovalListContainer"
                              Grid.Row="1"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedAppsCountText"
                                           Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Text="0 selecionado(s)" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource App.AccentText}"
                                           VerticalAlignment="Center"
                                           Text="Somente remoção de apps" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="286"
                                    Background="{DynamicResource App.Layer}"
                                    BorderBrush="{DynamicResource App.Divider}"
                                    BorderThickness="1"
                                    CornerRadius="0">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="RemovableAppsList" AlternationCount="512">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border x:Name="RowSep" Height="1" Background="{DynamicResource App.Divider}" Margin="12,0" />
                                                        <Grid Margin="12,9" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="13.5"
                                                                           Foreground="{DynamicResource App.Text}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding PackageName}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource App.TextTertiary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <Border x:Name="DefaultChip"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource Chip.Accent}"
                                                                    Padding="6,2"
                                                                    Margin="0,0,12,0"
                                                                    Visibility="Collapsed">
                                                                <TextBlock Text="Padrão" FontSize="10" Foreground="{DynamicResource App.AccentText}" />
                                                            </Border>

                                                            <CheckBox Grid.Column="2"
                                                                      Style="{StaticResource Check.Fluent}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center"
                                                                      Click="RemovableAppCheck_Click" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                            <Setter TargetName="RowSep" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter TargetName="DefaultChip" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock x:Name="NoRemovableAppsText"
                                               Text="Nenhum aplicativo pré-instalado removível foi encontrado neste computador."
                                               Style="{StaticResource Text.Caption}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="24"
                                               TextAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource App.DialogFooter}"
                            BorderBrush="{DynamicResource App.Divider}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <UniformGrid Columns="2">
                            <Button Content="Cancelar"
                                    Style="{StaticResource Btn.Standard}"
                                    Margin="0,0,4,0"
                                    Click="CancelAppRemoval_Click" />
                            <Button x:Name="ConfirmRemoveAppsButton"
                                    Content="Remover apps selecionados"
                                    Style="{StaticResource Btn.Accent}"
                                    Margin="4,0,0,0"
                                    Click="ConfirmRemoveApps_Click" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="KlyraOptimizer.Views.OptimizerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KlyraOptimizer.Views"
             Background="Transparent"
             FontFamily="{StaticResource Font.Ui}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,36" MaxWidth="1100" HorizontalAlignment="Left">

                <TextBlock Text="Otimizador" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Text="Escolha o perfil de desempenho, configure os controles nativos e aplique com um clique. Toda a execução ocorre silenciosamente em segundo plano." />

                <!-- ===================== PERFIS DE OTIMIZACAO ===================== -->
                <TextBlock Text="Perfil de otimização" Style="{StaticResource Text.Subheader}" Margin="0,24,0,12" />

                <UniformGrid Columns="3">
                    <RadioButton x:Name="ModeStandard" GroupName="Mode" Style="{StaticResource ModeCard}" IsChecked="True">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="18"
                                           Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Standard" Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       Text="Leve e seguro. Telemetria, ID de anúncio, Copilot, GameDVR, MMCSS, NTFS, Fast Startup e limpeza de temporários." />
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                <TextBlock Text="Risco baixo" Style="{StaticResource Chip.Text}"
                                           Foreground="{DynamicResource App.SuccessText}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ModeMedium" GroupName="Mode" Style="{StaticResource ModeCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEC4A;" Style="{StaticResource Icon}" FontSize="18"
                                           Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Medium" Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       Text="Inclui o Standard + ajustes de rede TCP, 18 serviços em segundo plano, remoção de bloatware AppX e bloqueio IFEO." />
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                <TextBlock Text="Equilibrado" Style="{StaticResource Chip.Text}"
                                           Foreground="{DynamicResource App.Warning}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="ModeAdvanced" GroupName="Mode" Style="{StaticResource ModeCard}" Margin="0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="18"
                                           Foreground="{DynamicResource App.AccentText}" />
                                <TextBlock Text="Avançado" Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                                       Text="Inclui o Medium + kernel na RAM, PoolUsage, BCD (x2APIC/TSC), HAGS, TDR, MSI Mode das GPUs e desativação de VBS/HVCI." />
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Left" Margin="0,14,0,0">
                                <TextBlock Text="Extremo" Style="{StaticResource Chip.Text}"
                                           Foreground="{DynamicResource App.Danger}" />
                            </Border>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <!-- ===================== OPCOES COM CONTROLES NATIVOS WIN10 1809 ===================== -->
                <TextBlock Text="Opções de configuração" Style="{StaticResource Text.Subheader}" Margin="0,28,0,12" />

                <Border Style="{StaticResource Card}">
                    <StackPanel>

                        <!-- ComboBox 1: Compressao CompactOS -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Compressão do sistema (CompactOS)" Style="{StaticResource Text.CardTitle}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Comprimir economiza espaço no SSD; descomprimir libera ciclos de CPU." />
                            </StackPanel>
                            <ComboBox x:Name="CompactCombo" Grid.Column="1" Width="230" SelectedIndex="0" VerticalAlignment="Center">
                                <ComboBoxItem Content="Manter configuração atual" Tag="skip" />
                                <ComboBoxItem Content="Descomprimir (never)" Tag="never" />
                                <ComboBoxItem Content="Comprimir sistema (always)" Tag="always" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                        <!-- ComboBox 2: Microsoft Store oficial -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Microsoft Store oficial" Style="{StaticResource Text.CardTitle}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="A Loja integrada do Klyra Optimizer instala aplicativos sem conta Microsoft." />
                            </StackPanel>
                            <ComboBox x:Name="StoreCombo" Grid.Column="1" Width="230" SelectedIndex="0" VerticalAlignment="Center">
                                <ComboBoxItem Content="Manter loja intacta" Tag="keep" />
                                <ComboBoxItem Content="Desativar só os serviços" Tag="services" />
                                <ComboBoxItem Content="Remover aplicativo oficial" Tag="remove" />
                            </ComboBox>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                        <!-- ToggleSwitch 1: Windows Update -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Manter Windows Update ativo (com proteção de drivers)" Style="{StaticResource Text.CardTitle}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Desligue caso prefira desativar completamente os serviços de atualização automática." />
                            </StackPanel>
                            <CheckBox x:Name="UpdateKeepSwitch" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch.Win10}"
                                      IsChecked="True" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                        <!-- ToggleSwitch 2: Bluetooth -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Manter serviços de Bluetooth ativos" Style="{StaticResource Text.CardTitle}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Desligue se não utiliza fones ou controles Bluetooth para economizar memória." />
                            </StackPanel>
                            <CheckBox x:Name="BluetoothKeepSwitch" Grid.Column="1"
                                      Style="{StaticResource ToggleSwitch.Win10}"
                                      IsChecked="True" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                        <!-- Slider Win10: MenuShowDelay -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Latência de exibição de menus (MenuShowDelay)" Style="{StaticResource Text.CardTitle}" />
                                <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                           Text="Padrão do Windows: 400 ms  •  Recomendado pelo Klyra: 50 ms." />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider x:Name="MenuDelaySlider" Width="176" Minimum="0" Maximum="400" Value="50"
                                        TickFrequency="10" IsSnapToTickEnabled="True"
                                        ValueChanged="MenuDelaySlider_ValueChanged" />
                                <TextBlock x:Name="MenuDelayLabel" Text="50 ms" Width="54" TextAlignment="Right"
                                           FontSize="13" Foreground="{DynamicResource App.Text}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== EXECUCAO ===================== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <views:Win10ProgressBar x:Name="BusyBar" Height="6" Visibility="Collapsed" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="Execução em segundo plano" Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusText" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Text="Pronto para otimizar." TextWrapping="Wrap" />
                                <ProgressBar x:Name="CompletionBar" Height="4" Minimum="0" Maximum="100" Value="0"
                                             Visibility="Collapsed" Margin="0,10,24,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                    <TextBlock x:Name="AppliedChip" Text="Aplicados 0" Style="{StaticResource Chip.Text}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                    <TextBlock x:Name="SkippedChip" Text="Pulados 0" Style="{StaticResource Chip.Text}" />
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,14,0">
                                    <TextBlock x:Name="FailedChip" Text="Erros 0" Style="{StaticResource Chip.Text}" />
                                </Border>

                                <views:Win10ProgressRing x:Name="BusyRing" Width="22" Height="22"
                                                         Visibility="Collapsed" Margin="0,0,12,0" />

                                <Button x:Name="ApplyButton" Content="Aplicar otimização" Style="{StaticResource Btn.Accent}"
                                        Height="34" Padding="20,0" Click="Apply_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== CONTENTDIALOG WIN10: ESCOLHAM APPS PARA SEREM REMOVIDOS ===================== -->
        <Grid x:Name="ConfirmOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Width="560"
                    MaxHeight="560"
                    Background="{DynamicResource App.CardSolid}"
                    BorderBrush="{DynamicResource App.CardStrokeHover}"
                    BorderThickness="1"
                    CornerRadius="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="24,20,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Escolham apps para serem removidos"
                                       FontSize="20"
                                       FontWeight="Light"
                                       Foreground="{DynamicResource App.Text}" />
                            <TextBlock x:Name="AppRemovalSubtitle"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,6,0,12"
                                       Text="Os aplicativos desnecessários padrão já vêm marcados automaticamente. Desmarque caso queira manter algum deles." />
                        </StackPanel>

                        <!-- Estado central de carregamento: ProgressRing + "Carregando apps do computador" -->
                        <StackPanel x:Name="AppRemovalLoadingPanel"
                                    Grid.Row="1"
                                    MinHeight="230"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <views:Win10ProgressRing Width="36" Height="36" HorizontalAlignment="Center" />
                            <TextBlock Text="Carregando apps do computador"
                                       Style="{StaticResource Text.Body}"
                                       Foreground="{DynamicResource App.TextSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,14,0,0" />
                        </StackPanel>

                        <!-- Lista de aplicativos carregados com CheckBox ao lado -->
                        <Grid x:Name="AppRemovalListContainer"
                              Grid.Row="1"
                              Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedAppsCountText"
                                           Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center"
                                           Text="0 selecionado(s)" />
                                <TextBlock x:Name="SelectedProfileSummaryText"
                                           Grid.Column="1"
                                           Style="{StaticResource Text.Caption}"
                                           Foreground="{DynamicResource App.AccentText}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Border Grid.Row="1"
                                    Height="286"
                                    Background="{DynamicResource App.Layer}"
                                    BorderBrush="{DynamicResource App.Divider}"
                                    BorderThickness="1"
                                    CornerRadius="0">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl x:Name="RemovableAppsList" AlternationCount="512">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Border x:Name="RowSep" Height="1" Background="{DynamicResource App.Divider}" Margin="12,0" />
                                                        <Grid Margin="12,9" Background="Transparent">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding DisplayName}"
                                                                           FontSize="13.5"
                                                                           Foreground="{DynamicResource App.Text}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding PackageName}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource App.TextTertiary}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>

                                                            <Border x:Name="DefaultChip"
                                                                    Grid.Column="1"
                                                                    Style="{StaticResource Chip.Accent}"
                                                                    Padding="6,2"
                                                                    Margin="0,0,12,0"
                                                                    Visibility="Collapsed">
                                                                <TextBlock Text="Padrão" FontSize="10" Foreground="{DynamicResource App.AccentText}" />
                                                            </Border>

                                                            <CheckBox Grid.Column="2"
                                                                      Style="{StaticResource Check.Fluent}"
                                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalAlignment="Center"
                                                                      Click="RemovableAppCheck_Click" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                                            <Setter TargetName="RowSep" Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                            <Setter TargetName="DefaultChip" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock x:Name="NoRemovableAppsText"
                                               Text="Nenhum aplicativo pré-instalado removível foi encontrado neste computador."
                                               Style="{StaticResource Text.Caption}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="24"
                                               TextAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{DynamicResource App.DialogFooter}"
                            BorderBrush="{DynamicResource App.Divider}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <UniformGrid Columns="2">
                            <Button Content="Cancelar"
                                    Style="{StaticResource Btn.Standard}"
                                    Margin="0,0,4,0"
                                    Click="CancelConfirm_Click" />
                            <Button x:Name="ConfirmApplyButton"
                                    Content="Aplicar Otimização"
                                    Style="{StaticResource Btn.Accent}"
                                    Margin="4,0,0,0"
                                    Click="ConfirmApply_Click" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== CONTENTDIALOG WIN10: REINICIAR ===================== -->
        <Grid x:Name="RebootOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Width="500"
                    Background="{DynamicResource App.CardSolid}"
                    BorderBrush="{DynamicResource App.CardStrokeHover}"
                    BorderThickness="1"
                    CornerRadius="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,20,24,20">
                        <TextBlock Text="Otimização concluída"
                                   FontSize="20" FontWeight="Light" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="RebootSummary" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                   Text="Recomendamos reiniciar o computador para efetivar os ajustes de kernel, BCD e GPU." />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="{DynamicResource App.DialogFooter}"
                            BorderBrush="{DynamicResource App.Divider}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <UniformGrid Columns="2">
                            <Button Content="Reiniciar agora" Style="{StaticResource Btn.Accent}" Margin="0,0,4,0"
                                    Click="RebootNow_Click" />
                            <Button Content="Depois" Style="{StaticResource Btn.Standard}" Margin="4,0,0,0"
                                    Click="RebootLater_Click" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="KlyraOptimizer.Views.RestorePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KlyraOptimizer.Views"
             Background="Transparent"
             FontFamily="{StaticResource Font.Ui}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,20,32,36" MaxWidth="1100" HorizontalAlignment="Left">

                <TextBlock Text="Restauração" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Text="Pontos de restauração do Windows, reversão completa dos ajustes e utilitário oficial do sistema." />

                <!-- ===================== STATUS ===================== -->
                <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                    <StackPanel>
                        <views:Win10ProgressBar x:Name="BusyBar" Height="6" Visibility="Collapsed" Margin="0,0,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="42" Height="42"
                                    Background="{DynamicResource App.ControlFill}"
                                    BorderBrush="{DynamicResource App.CardStroke}"
                                    BorderThickness="1"
                                    CornerRadius="0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="ProtectionGlyph" Text="&#xE81C;" Style="{StaticResource Icon}"
                                           FontSize="19" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ProtectionTitle" Text="Proteção do Sistema"
                                           Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProtectionText" Style="{StaticResource Text.Caption}" Margin="0,3,0,0"
                                           Text="Verificando..." />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <views:Win10ProgressRing x:Name="BusyRing" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,10,0" />
                                <Button Content="Ativar proteção" Style="{StaticResource Btn.SmallSubtle}" Margin="0,0,6,0"
                                        Click="EnableProtection_Click" />
                                <Button Content="Criar ponto" Style="{StaticResource Btn.Small}" Margin="0,0,6,0"
                                        Click="CreatePoint_Click" />
                                <Button Content="Abrir rstrui.exe" Style="{StaticResource Btn.Small}"
                                        Click="OpenWizard_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===================== PONTOS ===================== -->
                <Grid Margin="0,28,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Pontos de restauração disponíveis" Style="{StaticResource Text.Subheader}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Atualizar lista" Style="{StaticResource Btn.SmallSubtle}"
                            Click="RefreshPoints_Click" />
                </Grid>

                <Border Style="{StaticResource Card}" Padding="10">
                    <Grid MinHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="PointsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,6"
                                                Background="{DynamicResource App.ControlFill}" BorderBrush="{DynamicResource App.CardStroke}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Border Style="{StaticResource Chip.Accent}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SequenceLabel}" Style="{StaticResource Chip.Text}"
                                                               Foreground="{DynamicResource App.AccentText}" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.CardTitle}" />
                                                    <TextBlock Text="{Binding Created}" Style="{StaticResource Text.Caption}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>

                                                <Button Grid.Column="2" Content="Restaurar" Style="{StaticResource Btn.Small}"
                                                        Tag="{Binding}" Click="RestorePoint_Click" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock x:Name="NoPoints" Text="Nenhum ponto de restauração encontrado."
                                   Style="{StaticResource Text.Caption}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- ===================== REVERSAO DIRETA ===================== -->
                <TextBlock Text="Reversão direta (sem ponto de restauração)" Style="{StaticResource Text.Subheader}"
                           Margin="0,28,0,12" />

                <Border Style="{StaticResource Card}" Background="{DynamicResource App.DangerSoft}" BorderBrush="{DynamicResource App.DangerFill}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Reverter todas as otimizações" Style="{StaticResource Text.CardTitle}" FontWeight="SemiBold" />
                            <TextBlock x:Name="RevertDetailText" Style="{StaticResource Text.Caption}" Margin="0,3,12,0"
                                       Text="Restaura os padrões originais do Windows em chaves de registro, serviços, BCD e no modo MSI das GPUs." />
                        </StackPanel>

                        <Button Grid.Column="1" Content="Reverter tudo" Style="{StaticResource Btn.Danger}"
                                VerticalAlignment="Center" Click="RevertAll_Click" />
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===================== CONTENTDIALOG WIN10 ===================== -->
        <Grid x:Name="ConfirmOverlay" Background="#99000000" Visibility="Collapsed">
            <Border Width="500"
                    Background="{DynamicResource App.CardSolid}"
                    BorderBrush="{DynamicResource App.CardStrokeHover}"
                    BorderThickness="1"
                    CornerRadius="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="24,20,24,20">
                        <TextBlock x:Name="ConfirmTitle" Text="Confirmar"
                                   FontSize="20" FontWeight="Light" Foreground="{DynamicResource App.Text}" />
                        <TextBlock x:Name="ConfirmText" Style="{StaticResource Text.Body}" Margin="0,12,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            Background="{DynamicResource App.DialogFooter}"
                            BorderBrush="{DynamicResource App.Divider}"
                            BorderThickness="0,1,0,0"
                            Padding="24,16">
                        <UniformGrid Columns="2">
                            <Button x:Name="ConfirmGoButton" Content="Continuar" Style="{StaticResource Btn.Accent}" Margin="0,0,4,0"
                                    Click="ConfirmAction_Click" />
                            <Button Content="Cancelar" Style="{StaticResource Btn.Standard}" Margin="4,0,0,0"
                                    Click="CancelConfirm_Click" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

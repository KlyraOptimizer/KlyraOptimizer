<UserControl x:Class="KlyraOptimizer.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{StaticResource Font.Ui}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,20,32,40" MaxWidth="1100" HorizontalAlignment="Left">

            <TextBlock Text="Configurações" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Style="{StaticResource Text.PageSubtitle}"
                       Text="Inicialização, bandeja do sistema, modo de tema, especificações e registros silenciosos." />

            <!-- ===================== COMPORTAMENTO E BANDEJA DO SISTEMA ===================== -->
            <TextBlock Text="Inicialização e bandeja do sistema" Style="{StaticResource Text.Subheader}" Margin="0,24,0,12" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Iniciar junto com o sistema" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                       Text="Inicia o Klyra Optimizer automaticamente em segundo plano ao entrar no Windows." />
                        </StackPanel>
                        <CheckBox x:Name="StartWithWindowsSwitch"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch.Win10}"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Click="StartWithWindows_Click" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="Fechar e ficar na bandeja do sistema" Style="{StaticResource Text.CardTitle}" />
                            <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                       Text="Ao fechar a janela, mantém o ícone na bandeja com atalhos rápidos para Limpar RAM, Reset Rede e Fechar." />
                        </StackPanel>
                        <CheckBox x:Name="CloseToTraySwitch"
                                  Grid.Column="1"
                                  Style="{StaticResource ToggleSwitch.Win10}"
                                  IsChecked="True"
                                  VerticalAlignment="Center"
                                  Click="CloseToTray_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===================== TEMA (IGUAL AO SETTINGSPAGE DA XAML CONTROLS GALLERY) ===================== -->
            <TextBlock Text="Modo de tema" Style="{StaticResource Text.Subheader}" Margin="0,28,0,12" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource Radio.Win10}"
                                 Content="Claro" Click="Theme_Click" Tag="light" />
                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource Radio.Win10}"
                                 Content="Escuro" Click="Theme_Click" Tag="dark" />
                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource Radio.Win10}"
                                 Content="Usar configuração do Windows" Margin="0" IsChecked="True" Click="Theme_Click" Tag="system" />
                    <TextBlock x:Name="ThemeDetail" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                               Text="Segue automaticamente o tema claro/escuro e a cor de destaque do Windows." />
                </StackPanel>
            </Border>

            <!-- ===================== SISTEMA ===================== -->
            <TextBlock Text="Especificações do dispositivo" Style="{StaticResource Text.Subheader}" Margin="0,28,0,12" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Edição do Windows" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="InfoOs" Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="13" Foreground="{DynamicResource App.Text}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Compilação do SO" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="InfoBuild" Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="13" Foreground="{DynamicResource App.Text}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Dispositivo / usuário" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="InfoMachine" Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="13" Foreground="{DynamicResource App.Text}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Privilégios" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="InfoAdmin" Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="13" Foreground="{DynamicResource App.Text}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="winget (App Installer)" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="InfoWinget" Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="13" Foreground="{DynamicResource App.Text}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="210" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Perfil ativo" Style="{StaticResource Text.Caption}" />
                        <TextBlock x:Name="InfoMode" Grid.Column="1" Style="{StaticResource Text.Body}" FontSize="13" Foreground="{DynamicResource App.Text}" />
                    </Grid>

                    <Border Style="{StaticResource Divider}" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Reiniciar como administrador" Style="{StaticResource Btn.Standard}"
                                x:Name="ElevateButton" Margin="0,0,8,0" Click="Elevate_Click" />
                        <Button Content="Atualizar informações" Style="{StaticResource Btn.SmallSubtle}"
                                Click="Refresh_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== LOGS EM SEGUNDO PLANO ===================== -->
            <TextBlock Text="Registros em segundo plano (Logs)" Style="{StaticResource Text.Subheader}" Margin="0,28,0,12" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Arquivo de log desta sessão" Style="{StaticResource Text.CardTitle}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,6"
                               Text="Todas as operações rodam silenciosamente sem console na tela e salvam o histórico completo em:" />
                    <TextBlock x:Name="InfoLogPath" Style="{StaticResource Text.Mono}"
                               TextWrapping="Wrap" Text="—" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Abrir pasta de logs" Style="{StaticResource Btn.Standard}" Margin="0,0,8,0"
                                Click="OpenLogs_Click" />
                        <Button Content="Abrir arquivo de log atual" Style="{StaticResource Btn.SmallSubtle}"
                                Click="OpenLogFile_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================== SOBRE ===================== -->
            <TextBlock Text="Sobre" Style="{StaticResource Text.Subheader}" Margin="0,28,0,12" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/KlyraOptimizer.png"
                               Width="36" Height="36"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Margin="0,0,14,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Klyra Optimizer" Style="{StaticResource Text.CardTitle}" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersion" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                       Text="Versão 1.6.1 — Windows 10 Fluent Edition (1809/1903)" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" Margin="0,12,0,0"
                               Text="Interface Fluent Design clássica do Windows 10 (Acrylic Blur, Reveal Highlight, Tilt Effect 3D e controles nativos inspirados na XAML Controls Gallery)." />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                               Text="Requisitos: Windows 10 21H2 (build 19044) ou superior, incluindo Windows 11 (x64)." />

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Abrir pasta de instalação" Style="{StaticResource Btn.Standard}"
                                Margin="0,0,8,0" Click="OpenInstallFolder_Click" />
                        <Button x:Name="UninstallButton" Content="Desinstalar" Style="{StaticResource Btn.Danger}"
                                Click="Uninstall_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

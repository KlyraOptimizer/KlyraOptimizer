<UserControl x:Class="KlyraOptimizer.Views.ToolsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:KlyraOptimizer.Views"
             Background="Transparent"
             FontFamily="{StaticResource Font.Ui}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,16,36,36" MaxWidth="1100" HorizontalAlignment="Left">

                <TextBlock Text="Ferramentas" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Style="{StaticResource Text.PageSubtitle}"
                           Text="Diagnóstico do sistema, utilitários open source e controles avançados de hardware." />

                <!-- ===================== SCANNER ===================== -->
                <Grid Margin="0,24,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Scanner de conflitos" Style="{StaticResource Text.Subheader}" />
                        <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                                   Text="Verifica ajustes que outro script já aplicou no sistema antes de otimizar." />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <views:Win10ProgressRing x:Name="BusyRing" Width="18" Height="18" Visibility="Collapsed" Margin="0,0,10,0" />
                        <Button Content="Escanear agora" Style="{StaticResource Btn.Standard}" Click="Scan_Click" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource Card}" Padding="0">
                    <ItemsControl x:Name="ConflictList" AlternationCount="32">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border x:Name="Sep" Height="1" Background="{DynamicResource App.Divider}" Margin="16,0" />
                                    <Grid Margin="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="32" Height="32"
                                                Background="{DynamicResource App.ControlFill}" VerticalAlignment="Center">
                                            <TextBlock x:Name="GlyphText" Text="{Binding Glyph}"
                                                       Style="{StaticResource Icon}" FontSize="14"
                                                       Foreground="{DynamicResource App.TextSecondary}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border x:Name="StateChip" Grid.Column="2" Style="{StaticResource Chip}"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="StateLabel" Text="{Binding StatusText}"
                                                       Style="{StaticResource Chip.Text}" />
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                        <Setter TargetName="Sep" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Detected}" Value="True">
                                        <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource App.WarningSoft}" />
                                        <Setter TargetName="StateChip" Property="BorderBrush" Value="{DynamicResource App.Warning}" />
                                        <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource App.Warning}" />
                                        <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource App.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Detected}" Value="False">
                                        <Setter TargetName="StateChip" Property="Background" Value="{DynamicResource App.SuccessSoft}" />
                                        <Setter TargetName="StateChip" Property="BorderBrush" Value="{DynamicResource App.Success}" />
                                        <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource App.SuccessText}" />
                                        <Setter TargetName="GlyphText" Property="Foreground" Value="{DynamicResource App.SuccessText}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- ===================== OPEN SOURCE ===================== -->
                <Grid Margin="0,28,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ferramentas open source" Style="{StaticResource Text.Subheader}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ToolActionStatus" Grid.Column="1" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </Grid>

                <UniformGrid Columns="3">
                    <Button Style="{StaticResource Btn.Tile}" Click="WinUtil_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource App.Accent}" />
                            <TextBlock Text="Chris Titus WinUtil" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,2" />
                            <TextBlock Text="Abre o WinUtil em uma janela do PowerShell" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Click="BleachBit_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource App.Accent}" />
                            <TextBlock Text="BleachBit" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,2" />
                            <TextBlock Text="Instala o limpador silenciosamente via winget" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Btn.Tile}" Margin="0" Click="GoRestore_Click">
                        <StackPanel>
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" FontSize="22"
                                       HorizontalAlignment="Left" Foreground="{DynamicResource App.Accent}" />
                            <TextBlock Text="Reverter padrões" Style="{StaticResource Text.CardTitle}" Margin="0,10,0,2" />
                            <TextBlock Text="Volta ao Windows original sem ponto" Style="{StaticResource Text.Caption}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- ===================== GPU ===================== -->
                <TextBlock Text="Hardware • MSI Mode (interrupções da GPU)" Style="{StaticResource Text.Subheader}" Margin="0,28,0,12" />

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="GPUs PCI detectadas" Style="{StaticResource Text.CardTitle}" />
                            <ItemsControl x:Name="GpuList" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Chip}" Padding="8,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Vendor}" Style="{StaticResource Chip.Text}" FontSize="10" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Text.Body}"
                                                       FontSize="13" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="GpuStatus" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"
                                       Text="O modo MSI reduz a latência de interrupção da GPU. Requer reinício." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Reverter MSI" Style="{StaticResource Btn.SmallSubtle}" Margin="0,0,8,0"
                                    Click="GpuRevert_Click" />
                            <Button Content="Aplicar MSI" Style="{StaticResource Btn.Small}" Click="GpuApply_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
